#!/bin/sh
# Installed as .git/hooks/pre-commit by `make install-hooks` (from PROJECT_ROOT). This shim is the only
# thing that lives outside PROJECT_ROOT once installed; the actual check is
# scripts/check_project_root_scope.py, tracked and reviewable inside PROJECT_ROOT like everything else.
#
# git hooks run with CWD at the repo root (the monorepo root here), not PROJECT_ROOT, so the path to the
# real script and its venv is resolved explicitly rather than assumed.
set -eu

PROJECT_ROOT="AWS-Insurance-FNOL-Voice-Agentic-AI"
CHECK="$PROJECT_ROOT/scripts/check_project_root_scope.py"

if [ -x "$PROJECT_ROOT/.venv/bin/python" ]; then
    PYTHON="$PROJECT_ROOT/.venv/bin/python"
else
    PYTHON="python3"
fi

exec "$PYTHON" "$CHECK"
