# Copy to .env and fill in — never commit the real file.
OPENAI_API_KEY=

# Every demo defaults to SHOWCASE_FAST_MODEL. Only Research Analyst's web
# research and report writing upgrade to SHOWCASE_RESEARCH_MODEL.
SHOWCASE_FAST_MODEL=openai:gpt-5-mini
SHOWCASE_RESEARCH_MODEL=openai:gpt-5.2
SHOWCASE_MAX_REVISIONS=1

# Demo sign-in. One static account — not real authentication (see app/auth.py).
SHOWCASE_DEMO_USER=demo@contoso.com
SHOWCASE_DEMO_PASSWORD=contoso
# Leave unset to generate a random per-process secret (sessions end on restart).
SHOWCASE_SESSION_SECRET=

LOGFIRE_TOKEN=
