# Azure CDSS Pipeline - Environment Configuration
# Copy this file to .env and fill in the values

# === Required: Azure ===
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_LOCATION=westus2
AZURE_RESOURCE_GROUP=cdss-dev-rg
AZURE_ENVIRONMENT=dev

# === Required: PubMed ===
# Get your API key from: https://www.ncbi.nlm.nih.gov/account/ -> API Key Management
CDSS_PUBMED_API_KEY=your-pubmed-api-key
CDSS_PUBMED_EMAIL=your-email@example.com

# === Optional: Source Directory ===
# Path to cdss-agentic-rag source (default: ../cdss-agentic-rag relative to this project)
# CDSS_SOURCE_DIR=../cdss-agentic-rag

# === Optional: DrugBank ===
# CDSS_DRUGBANK_API_KEY=your-drugbank-api-key

# === Optional: Deployment Overrides ===
# CDSS_SKIP_AUTH_SETUP=false
# CDSS_SKIP_FRONTEND_DEPLOY=false
# CDSS_IMAGE_BUILD_MODE=local
# CDSS_OPENAI_NETWORK_AUTOFIX=true
# CDSS_KV_TEMP_IP_ALLOWLIST=true
