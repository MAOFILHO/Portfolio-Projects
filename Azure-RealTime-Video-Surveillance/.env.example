# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# ── Azure target ────────────────────────────────────────────
AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=eastus2
# VISION_LOCATION: kept independent of AZURE_LOCATION. Image Analysis 4.0
# Captions are only available in eastus on the free F0 tier (not eastus2),
# so the Vision resource is deployed there while everything else uses
# AZURE_LOCATION above.
VISION_LOCATION=eastus
AZURE_RESOURCE_GROUP=surveil-rg
AZURE_ENV_NAME=surveil

# ── Cost-relevant SKUs ──────────────────────────────────────
# VISION_SKU: F0 = free tier (1 per subscription, 20 calls/min), S1 = pay-per-call
VISION_SKU=S1
STORAGE_SKU_NAME=Standard_LRS

# ANALYZER_BACKEND: azure_vision (default, Azure AI Vision Image Analysis 4.0)
# or ssd_mobilenet (self-hosted SSD-MobileNet model, no Vision API calls/cost
# for detection -- captions are still azure_vision-only). See
# shared/surveil_core/analyzer.py.
ANALYZER_BACKEND=azure_vision

# ── Alert rules ─────────────────────────────────────────────
# Comma-separated tags that trigger an alert (Azure AI Vision object/people tags)
ALERT_WATCH_TAGS=person,knife,gun
ALERT_MIN_CONFIDENCE=0.6
ALERT_MIN_COUNT=1
CAPTURE_INTERVAL_SECONDS=3

# Optional "tag:severity,tag:severity" override of the tag -> severity
# (critical/high/medium/low) map. Leave empty to use the built-in default:
# weapon/gun/knife -> critical, trespassing -> high, crowd -> medium,
# person -> low, anything else -> low.
# Example: dog:high,cat:medium
ALERT_SEVERITY_MAP=

# Crowd rule: synthesizes a "crowd" alert tag (severity: medium) when the
# number of detected people in a frame is >= this threshold. 0 disables it.
ALERT_CROWD_THRESHOLD=0

# Trespassing/restricted-zone rule: synthesizes a "trespassing" alert tag
# (severity: high) when a detected person's bounding-box center falls inside
# this rectangle. Format: "x_min,y_min,x_max,y_max", normalized 0.0-1.0
# image-fraction coordinates (resolution-independent). Leave empty to
# disable. Example covering most of the frame: 0.1,0.1,0.9,0.9
ALERT_RESTRICTED_ZONE=

# ── Azure Communication Services (email/SMS alerting) ──────
# Leave these empty to deploy without alert emails/SMS (WebSocket alerts to
# the dashboard still work). ACS_SENDER_EMAIL is auto-filled from the
# Bicep-provisioned Azure-managed domain if left empty.
ACS_SENDER_EMAIL=
ALERT_EMAIL_TO=
ALERT_SMS_TO=
ACS_SMS_FROM=

# ── Langfuse (opt-in LLM/agent-level tracing) ──────────────
# Leave LANGFUSE_PUBLIC_KEY empty to deploy without it (the in-app "AI Agents
# Activity" page still works either way). Get keys from a free Langfuse Cloud
# project at cloud.langfuse.com, or your own self-hosted instance.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Build behavior ──────────────────────────────────────────
# IMAGE_BUILD_MODE: acr (recommended, especially on Apple Silicon) or local
IMAGE_BUILD_MODE=acr

# ── Nest doorbell ingestor (opt-in; always-on Container App) ──────
# Leave NEST_INGESTOR_ENABLED=false to skip entirely (default; no Google/GCP
# credentials needed, no extra compute cost). Enabling this deploys a second
# Container App that runs 24/7 and can never scale to zero -- see
# docs/cost.md before turning it on. See ingestors/nest/README.md for how to
# obtain every value below (Google OAuth refresh token, GCP service account).
NEST_INGESTOR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DEVICE_ACCESS_PROJECT_ID=
GOOGLE_DEVICES=
GCP_PUBSUB_PROJECT_ID=
GCP_PUBSUB_SUBSCRIPTION_ID=nest-surveillance-sub
# Path to a GCP service-account JSON key with roles/pubsub.subscriber on the
# subscription above (never commit this file).
GCP_SERVICE_ACCOUNT_KEY_PATH=
