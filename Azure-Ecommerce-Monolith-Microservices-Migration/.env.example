# Copy this file to .env and fill in values. Never commit the real .env file.
# No third-party API keys are required anywhere in this project.

# --- Global ---
# local  -> SQLite everywhere, all services run as plain Python processes on localhost
# azure  -> services read Azure Database for MySQL connection info below
RUN_MODE=local
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string

# --- Service ports (local mode) ---
MONOLITH_PORT=6000
USER_SERVICE_PORT=5001
PRODUCT_SERVICE_PORT=5002
ORDER_SERVICE_PORT=5003
BFF_PORT=8000
FRONTEND_PORT=5173

# --- Service base URLs (used by the BFF and by services calling each other) ---
MONOLITH_BASE_URL=http://127.0.0.1:6000
USER_SERVICE_BASE_URL=http://127.0.0.1:5001
PRODUCT_SERVICE_BASE_URL=http://127.0.0.1:5002
ORDER_SERVICE_BASE_URL=http://127.0.0.1:5003

# --- SQLite (local mode, default) ---
# Optional overrides — each path is relative to that service's own directory
# (e.g. MONOLITH_DB_PATH is relative to monolith/). Leave unset to use the
# built-in default of instance/<service>.sqlite3 inside each service folder.
# MONOLITH_DB_PATH=instance/monolith.sqlite3
# USER_DB_PATH=instance/user.sqlite3
# PRODUCT_DB_PATH=instance/product.sqlite3
# ORDER_DB_PATH=instance/order.sqlite3

# --- Azure Database for MySQL Flexible Server (azure mode only) ---
# Populated automatically into .env by infra/provision.py after provisioning.
# Never hardcode these — provision.py generates a random password.
AZURE_MYSQL_HOST=
AZURE_MYSQL_PORT=3306
AZURE_MYSQL_ADMIN_USER=
AZURE_MYSQL_ADMIN_PASSWORD=
AZURE_MYSQL_SSL_MODE=REQUIRED

# --- Azure subscription / region (azure mode only) ---
# infra/provision.py reads AZURE_LOCATION from here first (it's never
# hardcoded in code) — change it to deploy to a different region. Falls back
# to `az config get defaults.location`, then to "eastus", only if unset here.
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=rg-flask-monolith-microservices
AZURE_BUDGET_CEILING_USD=25
# Azure Static Web Apps only exists in a handful of regions (Central US, East
# US 2, West US 2, West Europe, East Asia) — NOT every region AZURE_LOCATION
# above might be set to (plain "East US" does not support it). Kept separate
# so the rest of the stack can deploy anywhere while this one resource still
# lands somewhere valid.
AZURE_STATIC_WEB_APP_LOCATION=eastus2

# --- Docker socket for Docker-based orchestration ---
# NOT USED in this project. All containers run exclusively on Azure Container Apps,
# built via `az acr build` (cloud-side build). No local Docker daemon is required.
