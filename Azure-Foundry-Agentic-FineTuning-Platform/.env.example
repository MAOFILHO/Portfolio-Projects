# ---------------------------------------------------------------------------
# Copy to .env and fill in.  NEVER commit .env — it is gitignored.
# Every value below is a KEY ONLY; no real secrets belong in this file.
# ---------------------------------------------------------------------------

# --- Execution mode --------------------------------------------------------
# mock = zero Azure calls, zero cost, runs from recorded fixtures (DEFAULT)
# live = calls real Azure AI Foundry and bills real tokens
DEMO_MODE=mock

# --- Azure ------------------------------------------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=eastus2

# Populated by `make provision` (terraform output). Only needed in live mode.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_PROJECT_NAME=
AZURE_RESOURCE_GROUP=

# --- Naming -----------------------------------------------------------------
# Base name; the auto-increment suffix (-v1, -v2, ...) is appended by Terraform.
PROJECT_BASE_NAME=foundry-travel

# --- Model deployments ------------------------------------------------------
MODEL_BASELINE=gpt-4.1
MODEL_BASELINE_VERSION=2025-04-14
MODEL_COMPARE_A=gpt-5.4
MODEL_COMPARE_A_VERSION=2026-03-05
MODEL_COMPARE_B=gpt-5.4-mini
MODEL_COMPARE_B_VERSION=2026-03-17

# --- Fine-tuning ------------------------------------------------------------
FT_SUFFIX=ft-travel
FT_DEPLOYMENT_TYPE=Developer
FT_TRAINING_TYPE=Developer

# --- Cost guard -------------------------------------------------------------
BUDGET_CEILING_USD=25
BUDGET_ALERT_EMAIL=

# --- Public hosting (see infra/terraform/hosting.tf) -------------------------
# Docker Hub username the backend image is pushed to — public repo, $0/mo,
# chosen over Azure Container Registry's ~$5/mo Basic tier.
DOCKERHUB_USERNAME=

# --- Observability ----------------------------------------------------------
# Populated by `make provision`. Leave blank to trace to terminal only.
APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=foundry-agentic-platform
OTEL_CONSOLE_EXPORT=true

# --- Frontend / API ---------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# --- Static demo auth (NOT real authentication; demo gate only) --------------
DEMO_USERNAME=demo
DEMO_PASSWORD=demo123
