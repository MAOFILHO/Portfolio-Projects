# Copy to .env in this same directory to override any of forecast-deploy's
# defaults (see src/forecast_deploy/config.py for what each one does).
# Nothing here is required -- every field has a cost-minimal default.

AZURE_SUBSCRIPTION_ID=
AZURE_LOCATION=eastus

RESOURCE_GROUP_BASE=rg-forecasting-platform
NAME_PREFIX_BASE=forecast

VM_SIZE=Standard_D4s_v3
VM_PRIORITY=Regular
OS_DISK_SIZE_GB=64
ADMIN_USERNAME=azureuser
SSH_PUBLIC_KEY_PATH=~/.ssh/id_ed25519.pub
