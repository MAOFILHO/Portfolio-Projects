# Path to the GlobalLandTemperaturesByMajorCity.csv dataset
DATA_PATH=data/GlobalLandTemperaturesByMajorCity.csv

# Path to save/load the TensorFlow/Keras LSTM model checkpoint
MODEL_PATH=models/TemperatureForecastingModel.keras

# Path to save/load the PyTorch LSTM model checkpoint
MODEL_PATH_PYTORCH=models/TemperatureForecastingModel_pytorch.pt

# Directory where per-model results (results/*.json), eda.json, and plot
# images are written
OUTPUT_DIR=outputs

# Number of LSTM training epochs, for both TensorFlow and PyTorch (10 matches
# the original notebook)
LSTM_EPOCHS=10

# Whether to retrain the LSTM models on each run, or reuse the existing
# checkpoints at MODEL_PATH / MODEL_PATH_PYTORCH ("true"/"false")
LSTM_RETRAIN=true

# Allowed CORS origin for the FastAPI service (the frontend dev server)
API_CORS_ORIGIN=http://localhost:5173

# --- PySpark ETL engine (requires a JDK 17 runtime on PATH) ---
# Spark master URL. "local[*]" runs an in-process engine using all cores; no
# cluster, no cost. Point this at a real master to scale out unchanged.
SPARK_MASTER=local[*]

# Memory for the Spark driver JVM. 2g is ample for this dataset.
SPARK_DRIVER_MEMORY=2g

# --- Kafka streaming layer (requires `docker compose up -d` at the repo root) ---
# Broker address for both src/kafka_producer.py and src/kafka_consumer.py.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Topic the producer publishes to and the consumer subscribes to.
KAFKA_TOPIC=temperature-telemetry

# Target replay rate for the producer, in messages/second.
KAFKA_PRODUCER_RATE=500

# Where the consumer's windowed-features Parquet snapshot (and its streaming
# checkpoint) are written; the API's streaming endpoint reads from here too.
STREAMING_OUTPUT_DIR=outputs/streaming
