# --- Google OAuth client (Google Cloud Console > APIs & Services > Credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# One-time only: generate via `python get_refresh_token.py`, then paste here and
# never regenerate unless it's revoked. This is the long-lived credential.
GOOGLE_REFRESH_TOKEN=

# --- Device Access Console (console.nest.google.com/device-access) ---
GOOGLE_DEVICE_ACCESS_PROJECT_ID=

# One or more "device_id:camera_id" pairs, comma-separated. device_id comes
# from GET .../enterprises/{project}/devices (the segment after
# ".../devices/"); camera_id is any label you want shown in the dashboard/
# event history. Only devices with the CameraClipPreview trait currently
# produce frames -- see README.md "CameraEventImage vs CameraClipPreview".
GOOGLE_DEVICES=AVPHwEtca...:nest-front-yard,AVPHwEtprl...:nest-front-door

# --- Pub/Sub (motion/person events) ---
# The current Device Access Console requires a self-hosted topic: you create
# the topic in your own GCP project, grant sdm-publisher@googlegroups.com
# publisher access to it, paste its path into the console's Events screen,
# then create your own subscription to pull from it. See README.md.
GCP_PUBSUB_PROJECT_ID=computervision1-503213
GCP_PUBSUB_SUBSCRIPTION_ID=nest-surveillance-sub

# Comma-separated SDM event types to react to. Options:
#   sdm.devices.events.CameraMotion.Motion
#   sdm.devices.events.CameraPerson.Person
#   sdm.devices.events.CameraSound.Sound
#   sdm.devices.events.CameraClipPreview.ClipPreview  (needed on WebRTC-only
#     devices -- see README.md "CameraEventImage vs CameraClipPreview")
WATCH_EVENT_TYPES=sdm.devices.events.CameraMotion.Motion,sdm.devices.events.CameraPerson.Person,sdm.devices.events.CameraClipPreview.ClipPreview

# --- Your existing Azure backend (Container Apps FastAPI) ---
BACKEND_URL=http://localhost:8000
